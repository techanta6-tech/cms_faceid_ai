# ========================================================================
# CMS FaceID AI - Unified Environment Configuration
# File này chứa toàn bộ cấu hình hệ thống (Docker, Backend, Frontend)
# Copy file này thành .env ở thư mục gốc để sử dụng.
# ========================================================================

# ------------------------------------------------------------------------
# 1. CẤU HÌNH DOCKER & DỊCH VỤ CHUNG (HOST)
# ------------------------------------------------------------------------
# Đường dẫn thư mục lưu ảnh cục bộ trên máy host (phục vụ việc mount Docker Volume)
HOST_IMAGE_PATH=C:\Program Files\DVMS System\DVMS Server\EventData

# ------------------------------------------------------------------------
# 2. CẤU HÌNH BACKEND (NESTJS)
# ------------------------------------------------------------------------
# Cổng chạy ứng dụng Backend
PORT=3001

# Connection string PostgreSQL cho database cms_webserver
CMS_WEBSERVER_DATABASE_URL=postgresql://postgres:your_secure_password@postgres-db:5432/cms_webserver?connect_timeout=15

# Connection string PostgreSQL cho database dvms_server
DVMS_DATABASE_URL=postgresql://postgres:@host.docker.internal:5433/dvms_server?connect_timeout=15

# Connection string PostgreSQL cho database lcms_server
LCMS_DATABASE_URL=postgresql://postgres:@host.docker.internal:5433/lcms_server?connect_timeout=15&pooling=true&minpoolsize=0&maxpoolsize=200

# Đường dẫn cục bộ lưu trữ hình ảnh/media trên host machine
IMAGE_LOCAL_PATH=C:/path/to/images

# Đường dẫn mount hình ảnh/media trong Docker container
IMAGE_MOUNT_PATH=/app/event-images

# Giờ làm việc cấu hình ca
SHIFT_START_TIME=07:30
SHIFT_END_TIME=17:00
SHIFT_BUFFER_HOURS=2

# Cấu hình tích hợp hệ thống LOVAD
LOVAD_LCMS_URL=https://localhost:18000
LOVAD_DVMS_URL=https://localhost:10180
LOVAD_USERNAME=admin
LOVAD_PASSWORD=admin@123

# ------------------------------------------------------------------------
# 3. CẤU HÌNH FRONTEND (REACT / VITE)
# ------------------------------------------------------------------------
# URL của Backend API và WebSocket Server
VITE_WS_URL=http://localhost:3001

# Gemini AI API Key (nếu sử dụng tính năng AI)
GEMINI_API_KEY=your_gemini_api_key_here
