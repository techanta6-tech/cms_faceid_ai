# ========================================================================
# CMS FaceID AI - Unified Environment Configuration
# File này chứa toàn bộ cấu hình hệ thống (Docker, Backend, Frontend)
# Copy file này thành .env ở thư mục gốc để sử dụng.
# ========================================================================

# ------------------------------------------------------------------------
# 1. CẤU HÌNH DOCKER & DỊCH VỤ CHUNG (HOST)
# ------------------------------------------------------------------------
# HOST_IMAGE_PATH: Đường dẫn tuyệt đối tới thư mục chứa ảnh sự kiện trên máy host Windows.
# - Ví dụ: C:\Program Files\DVMS System\DVMS Server\EventData (Thư mục lưu ảnh mặc định của DVMS Server trên Host).
# - Tác dụng: Được Docker Compose dùng để mount thư mục từ máy host vào bên trong container.
HOST_IMAGE_PATH=C:\Program Files\DVMS System\DVMS Server\EventData

# ------------------------------------------------------------------------
# 2. CẤU HÌNH BACKEND (NESTJS)
# ------------------------------------------------------------------------
# PORT: Cổng (Port) ứng dụng Backend NestJS chạy lắng nghe kết nối HTTP.
# - Ví dụ: 3001 (Backend chạy tại http://localhost:3001)
PORT=3001

# CMS_WEBSERVER_DATABASE_URL: Chuỗi kết nối PostgreSQL cho Cơ sở dữ liệu nội bộ `cms_webserver`.
# - Chi tiết giá trị ví dụ:
#   + postgresql://          : Giao thức kết nối PostgreSQL
#   + postgres              : Username truy cập DB
#   + your_secure_password  : Mật khẩu tài khoản DB
#   + postgres-db           : Hostname/Service name của PostgreSQL trong Docker network (dùng 'localhost' hoặc '127.0.0.1' nếu chạy backend trực tiếp ngoài máy host)
#   + 5432                  : Cổng kết nối PostgreSQL mặc định
#   + cms_webserver         : Tên Database nội bộ chứa dữ liệu hệ thống CMS
#   + ?connect_timeout=15   : Thời gian chờ kết nối tối đa (15 giây)
CMS_WEBSERVER_DATABASE_URL=postgresql://postgres:your_secure_password@postgres-db:5432/cms_webserver?connect_timeout=15

# DVMS_DATABASE_URL: Chuỗi kết nối PostgreSQL đến Cơ sở dữ liệu bên thứ 3 (`dvms_server`).
# - Chi tiết giá trị ví dụ:
#   + postgresql://postgres:@ : User 'postgres', không có mật khẩu (điền postgres:password@ nếu có mật khẩu)
#   + host.docker.internal   : Tên miền đặc biệt của Docker để container truy cập ra ngoài máy Host Windows
#   + 5433                   : Cổng kết nối PostgreSQL của DVMS Server đang lắng nghe trên máy Host
#   + dvms_server            : Tên Database chứa dữ liệu sự kiện/chấm công của hệ thống DVMS
#   + ?connect_timeout=15    : Thời gian chờ kết nối tối đa (15 giây)
DVMS_DATABASE_URL=postgresql://postgres:@host.docker.internal:5433/dvms_server?connect_timeout=15

# LCMS_DATABASE_URL: Chuỗi kết nối PostgreSQL đến Cơ sở dữ liệu bên thứ 3 (`lcms_server`).
# - Chi tiết giá trị ví dụ:
#   + postgresql://postgres:@ : User 'postgres', không có mật khẩu
#   + host.docker.internal:5433 : Trỏ tới dịch vụ PostgreSQL trên máy Host ở cổng 5433
#   + lcms_server             : Tên Database chứa dữ liệu phòng ban, nhân sự, lịch họp từ LCMS
#   + &pooling=true&minpoolsize=0&maxpoolsize=200 : Cấu hình connection pooling (tối thiểu 0, tối đa 200 connection)
LCMS_DATABASE_URL=postgresql://postgres:@host.docker.internal:5433/lcms_server?connect_timeout=15&pooling=true&minpoolsize=0&maxpoolsize=200

# IMAGE_LOCAL_PATH: Đường dẫn cục bộ lưu trữ hình ảnh/media trên máy host (khi chạy Backend ở môi trường local Dev ngoài Docker).
# - Ví dụ: C:/path/to/images (thay bằng đường dẫn thực tế chứa ảnh trên máy Host)
IMAGE_LOCAL_PATH=C:/path/to/images

# IMAGE_MOUNT_PATH: Đường dẫn đích mount thư mục hình ảnh bên trong Docker container.
# - Ví dụ: /app/event-images (thư mục trong container NestJS nhận dữ liệu ảnh từ HOST_IMAGE_PATH)
IMAGE_MOUNT_PATH=/app/event-images

# SHIFT_START_TIME & SHIFT_END_TIME: Khung giờ làm việc mặc định của ca (định dạng HH:mm).
# - Ví dụ: 07:30 (bắt đầu ca lúc 7h30 sáng), 17:00 (kết thúc ca lúc 17h00)
SHIFT_START_TIME=07:30
SHIFT_END_TIME=17:00

# SHIFT_BUFFER_HOURS: Số giờ đệm trước/sau ca làm việc cho phép ghi nhận sự kiện/điểm danh.
# - Ví dụ: 2 (cho phép quét khuôn mặt trước ca 2 tiếng và sau ca 2 tiếng)
SHIFT_BUFFER_HOURS=2

# Cấu hình tích hợp hệ thống LOVAD
# LOVAD_LCMS_URL & LOVAD_DVMS_URL: URL địa chỉ dịch vụ API/Web của LCMS và DVMS.
# - Ví dụ: https://localhost:18000 (Địa chỉ server LCMS), https://localhost:10180 (Địa chỉ server DVMS)
LOVAD_LCMS_URL=https://localhost:18000
LOVAD_DVMS_URL=https://localhost:10180
# LOVAD_USERNAME & LOVAD_PASSWORD: Tài khoản và mật khẩu quản trị dùng để gọi API tích hợp LOVAD.
# - Ví dụ: admin / admin@123
LOVAD_USERNAME=admin
LOVAD_PASSWORD=admin@123

# ------------------------------------------------------------------------
# 3. CẤU HÌNH FRONTEND (REACT / VITE)
# ------------------------------------------------------------------------
# VITE_WS_URL: URL kết nối HTTP/WebSocket của Frontend React (Vite) tới Backend NestJS.
# - Ví dụ: http://localhost:3001 (Địa chỉ IP/Host và Port của Backend NestJS)
VITE_WS_URL=http://localhost:3001

# GEMINI_API_KEY: Khóa API của Google Gemini AI (nếu dùng các tính năng phân tích/xử lý AI).
# - Ví dụ: your_gemini_api_key_here (thay bằng API Key được cấp từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

